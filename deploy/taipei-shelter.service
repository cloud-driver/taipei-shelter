[Unit]
Description=Anxing earthquake evacuation drill backend
After=network.target

[Service]
Type=simple
User=anxing
Group=anxing
WorkingDirectory=/opt/taipei-shelter
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=SHELTER_DATA_DIR=/var/lib/taipei-shelter
Environment=SHELTER_ALLOWED_HOSTS=localhost,127.0.0.1
EnvironmentFile=-/etc/taipei-shelter.env
ExecStart=/opt/taipei-shelter/.venv/bin/python -m uvicorn app.main:app_factory --factory --host 127.0.0.1 --port 8765 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
StateDirectory=taipei-shelter
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/taipei-shelter

[Install]
WantedBy=multi-user.target
